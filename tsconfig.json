{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "pit-run-background-activity": ["./modules/pit-run-background-activity/src/index.ts"],
      "pit-run-haptics": ["./modules/pit-run-haptics/src/index.ts"],
      "pit-run-live-activity": ["./modules/pit-run-live-activity/src/index.ts"],
      "pit-run-run-engine": ["./modules/pit-run-run-engine/src/index.ts"],
      "expo-modules-core": ["./node_modules/expo/node_modules/expo-modules-core"],
      "expo-modules-core/*": ["./node_modules/expo/node_modules/expo-modules-core/*"]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "supabase/functions"
  ]
