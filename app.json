{
  "expo": {
    "name": "pit-run",
    "slug": "pit-run",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#17171C"
    },
    "scheme": "pitrun",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pitrun.apps",
      "appleTeamId": "H2B5B8WXW6",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.pitrun.apps"
        ]
      },
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "달리는 동안 화면이 꺼져도 정확한 거리를 측정합니다.",
        "NSLocationAlwaysUsageDescription": "화면이 꺼진 상태에서도 러닝 세션을 추적합니다.",
        "NSLocationWhenInUseUsageDescription": "달리는 동안 정확한 거리를 측정합니다.",
        "UIBackgroundModes": [
          "location",
          "audio"
        ],
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "deploymentTarget": "16.1",
      "buildNumber": "8"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#17171C"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pitrun.apps",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-apple-authentication",
      "@bacons/apple-targets",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "달리는 동안 화면이 꺼져도 정확한 거리를 측정합니다.",
          "locationAlwaysPermission": "화면이 꺼진 상태에서도 러닝 세션을 추적합니다.",
          "locationWhenInUsePermission": "달리는 동안 정확한 거리를 측정합니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-audio",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.pitrun.apps.liveactivity",
                  "targetName": "PitRunLiveActivity",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.pitrun.apps"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "e0e2b2e6-7c79-44d0-9998-f371a45599e2"
      }
    }
  }
}
