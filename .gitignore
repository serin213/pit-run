# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# EAS local credentials (contains .p12 password)
/credentials.json
/secrets/

# Local build artifacts (xcodebuild archive / EAS local output)
# IPA는 코드가 아니라 빌드 산출물이라 git에 들어가면 안 됨.
*.ipa
/build-output/
# Xcode archive & export 출력. ios/build/generated는 ReactCodegen 산출물로
# 별도 관리하지만 ios/ 전체가 /ios로 gitignore되므로 이미 커버됨.
ios/build/

# Claude Code 워크트리 (git worktree add로 생성된 작업 사본). submodule이
# 아니라 워크트리이므로 git index에 트래킹되면 안 됨. EAS 업로드 시
# "filename casing inconsistent" pre-flight 에러 유발.
.claude/worktrees/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# EAS local credentials (contains .p12 password)
/credentials.json
/secrets/
